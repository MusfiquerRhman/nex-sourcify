  id                    Int       @id(map: "commission_percentage_historty_pkey") @default(autoincrement())
  commission_percentage Int?
  buyer_id              Int?
  other_percentage      Float?
  overseas_percentage   Float?
  action_type           actions?
  action_by             String?   @db.Uuid
  action_at             DateTime? @default(now()) @db.Timestamp(6)
  users                 users?    @relation(fields: [action_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "commission_percentage_historty_action_by_fkey")
}

model early_settlement_percentage {
  id       String    @id(map: "early_settelment_percentage_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyer_id Int
  charge   Float
  added_at DateTime? @default(now()) @db.Timestamp(6)
  buyers   buyers    @relation(fields: [buyer_id], references: [id], onUpdate: NoAction, map: "early_settelment_percentage_buyer_id_fkey")
}

model early_settlement_percentage_history {
  id                             String    @id(map: "early_settelment_percentage_history_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  early_settlement_percentage_id String?   @db.Uuid
  buyer_id                       Int?
  charge                         Float?
  added_at                       DateTime? @default(now()) @db.Timestamp(6)
  action_by                      String?   @db.Uuid
  action_at                      DateTime? @default(now()) @db.Timestamp(6)
  action_type                    actions?
  users                          users?    @relation(fields: [action_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "early_settelment_percentage_history_action_by_fkey")
}

model error_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamp(6)
  request_id     String   @db.Uuid
  procedure_name String
  request_method String   @db.VarChar(10)
  query_params   Json?
  ip_address     String?  @db.Inet
  user_agent     String?
  referer        String?
  input_data     Json?
  error_name     String   @db.VarChar(255)
  error_code     String?  @db.VarChar(100)
  user_id        String?  @db.Uuid
  error_message  String?
}

model early_settlement {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                 String                     @db.Uuid
  remarks                  String?
  added_at                 DateTime?                  @default(now()) @db.Timestamp(6)
  buyer_orders             buyer_orders               @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  early_settlement_details early_settlement_details[]
}

model early_settlement_details {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_details_id     String            @db.Uuid
  early_settlement_charge Float
  added_at                DateTime?         @default(now()) @db.Timestamp(6)
  early_settlement_id     String?           @db.Uuid
  early_settlement        early_settlement? @relation(fields: [early_settlement_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  shipment_details        shipment_details  @relation(fields: [shipment_details_id], references: [id], onUpdate: NoAction)
}

model early_settlement_details_history {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  early_settlement_details_id String?   @db.Uuid
  shipment_details_id         String?   @db.Uuid
  early_settlement_charge     Float?
  action_type                 actions?
  action_by                   String?   @db.Uuid
  action_at                   DateTime? @default(now()) @db.Timestamp(6)
  users                       users?    @relation(fields: [action_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum actions {
  UPDATE
  DELETE
  RESTORE
  ADDED
}

enum authorization_types {
  USER
  LEVEL
}

enum order_status {
  ACTIVE
  DELIVERED
  CANCELED
}

enum shipment_modes {
  SEA
  AIR
  LAND
  BY_ROAD @map("BY ROAD")
}
