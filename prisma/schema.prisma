generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model departments {
  id               Int                @id @default(autoincrement())
  name             String             @db.Char(15)
  authorizations   authorizations[]
  level_permission level_permission[]
  tna_actions      tna_actions[]
  users            users[]
}

model level_permission {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level_id      Int
  module_id     Int
  can_view      Boolean      @default(false)
  can_add       Boolean      @default(false)
  can_update    Boolean      @default(false)
  can_delete    Boolean      @default(false)
  can_trace     Boolean      @default(false)
  added_by      String?      @db.Uuid
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  department_id Int?
  users         users?       @relation(fields: [added_by], references: [id], onUpdate: NoAction)
  departments   departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels        levels       @relation(fields: [level_id], references: [id], onUpdate: NoAction)
  modules       modules      @relation(fields: [module_id], references: [id], onUpdate: NoAction)

  @@unique([module_id, level_id, department_id], map: "unique_module_per_level_and_department")
}

model level_permission_history {
  id                                              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level_id                                        Int
  module_id                                       Int
  can_view                                        Boolean   @default(false)
  can_add                                         Boolean   @default(false)
  can_update                                      Boolean   @default(false)
  can_delete                                      Boolean   @default(false)
  can_trace                                       Boolean   @default(false)
  added_by                                        String?   @db.Uuid
  created_at                                      DateTime? @default(now()) @db.Timestamptz(6)
  action                                          actions
  action_by                                       String?   @db.Uuid
  action_at                                       DateTime? @default(now()) @db.Timestamptz(6)
  level_permission_id                             String?   @db.Uuid
  past_action_time                                DateTime? @db.Timestamp(6)
  users_level_permission_history_action_byTousers users?    @relation("level_permission_history_action_byTousers", fields: [action_by], references: [id], onUpdate: NoAction)
  users_level_permission_history_added_byTousers  users?    @relation("level_permission_history_added_byTousers", fields: [added_by], references: [id], onUpdate: NoAction)
  levels                                          levels    @relation(fields: [level_id], references: [id], onUpdate: NoAction)
  modules                                         modules   @relation(fields: [module_id], references: [id], onUpdate: NoAction)
}

model levels {
  id                       Int                        @id @default(autoincrement())
  name                     String                     @unique(map: "unique_name") @db.VarChar(15)
  authorizations           authorizations[]
  level_permission         level_permission[]
  level_permission_history level_permission_history[]
  levels_history           levels_history[]
  users                    users[]
}

model levels_history {
  id        Int      @id @default(autoincrement())
  level_id  Int
  name      String?  @db.VarChar(15)
  action    actions
  action_by String   @db.Uuid
  action_at DateTime @default(now()) @db.Timestamptz(6)
  users     users    @relation(fields: [action_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels    levels   @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model modules {
  id                       Int                        @id @default(autoincrement())
  name                     String                     @db.VarChar(50)
  parent_module_id         Int?
  authorizations           authorizations[]
  level_permission         level_permission[]
  level_permission_history level_permission_history[]
  modules                  modules?                   @relation("modulesTomodules", fields: [parent_module_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_modules            modules[]                  @relation("modulesTomodules")
  permissions              permissions[]
  permissions_history      permissions_history[]
}

model permissions {
  id                                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                           String                @db.Uuid
  module_id                         Int
  can_view                          Boolean               @default(false)
  can_add                           Boolean               @default(false)
  can_update                        Boolean               @default(false)
  can_delete                        Boolean               @default(false)
  added_by                          String                @db.Uuid
  created_at                        DateTime?             @default(now()) @db.Timestamptz(6)
  can_trace                         Boolean?
  users_permissions_added_byTousers users                 @relation("permissions_added_byTousers", fields: [added_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  modules                           modules               @relation(fields: [module_id], references: [id], onUpdate: NoAction)
  users_permissions_user_idTousers  users                 @relation("permissions_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permissions_history               permissions_history[]
}

model permissions_history {
  id                                         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permission_id                              String?      @db.Uuid
  user_id                                    String       @db.Uuid
  module_id                                  Int
  can_view                                   Boolean      @default(false)
  can_add                                    Boolean      @default(false)
  can_update                                 Boolean      @default(false)
  can_delete                                 Boolean      @default(false)
  can_trace                                  Boolean      @default(false)
  added_by                                   String       @db.Uuid
  created_at                                 DateTime?    @default(now()) @db.Timestamptz(6)
  action                                     actions
  action_by                                  String?      @db.Uuid
  action_at                                  DateTime?    @default(now()) @db.Timestamptz(6)
  users_permissions_history_action_byTousers users?       @relation("permissions_history_action_byTousers", fields: [action_by], references: [id], onUpdate: NoAction)
  users_permissions_history_added_byTousers  users        @relation("permissions_history_added_byTousers", fields: [added_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  modules                                    modules      @relation(fields: [module_id], references: [id], onUpdate: NoAction)
  permissions                                permissions? @relation(fields: [permission_id], references: [id], onUpdate: NoAction)
  users_permissions_history_user_idTousers   users        @relation("permissions_history_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                                                 String                                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name                                                         String                                         @db.VarChar(25)
  last_name                                                          String?                                        @db.VarChar(25)
  phone_no                                                           String                                         @db.VarChar(18)
  password                                                           String
  email                                                              String                                         @db.VarChar(50)
  department_id                                                      Int
  is_active                                                          Boolean                                        @default(true)
  user_id                                                            String                                         @unique(map: "unique_user_id") @db.VarChar(20)
  hashed_password                                                    String
  level_id                                                           Int
  old_pk                                                             Int?
  created_at                                                         DateTime?                                      @default(now()) @db.Timestamp(6)
  authorizations                                                     authorizations[]
  banks_history_banks_history_action_byTousers                       banks_history[]                                @relation("banks_history_action_byTousers")
  buyer_additional_clause_history                                    buyer_additional_clause_history[]
  buyer_banks_history                                                buyer_banks_history[]
  buyer_brands_history                                               buyer_brands_history[]
  buyer_consignee_history                                            buyer_consignee_history[]
  buyer_department_sizes_history                                     buyer_department_sizes_history[]
  buyer_departments_history                                          buyer_departments_history[]
  buyer_destinations_history                                         buyer_destinations_history[]
  buyer_late_policies_history                                        buyer_late_policies_history[]
  buyer_orders_history                                               buyer_orders_history[]
  buyer_payment_term_history                                         buyer_payment_term_history[]
  buyers_history                                                     buyers_history[]
  color_history_color_history_action_byTousers                       color_history[]                                @relation("color_history_action_byTousers")
  commercial_tna_planning_details_history                            commercial_tna_planning_details_history[]
  commercial_tna_templates_actions_history                           commercial_tna_templates_actions_history[]
  commercial_tna_templates_history                                   commercial_tna_templates_history[]
  commission_distribution_details_history                            commission_distribution_details_history[]
  commission_distribution_history                                    commission_distribution_history[]
  commission_invoice_history                                         commission_invoice_history[]
  commission_percentage_history                                      commission_percentage_history[]
  companies_history_companies_history_action_byTousers               companies_history[]                            @relation("companies_history_action_byTousers")
  company_banks_history                                              company_banks_history[]
  countries_history_countries_history_action_byTousers               countries_history[]                            @relation("countries_history_action_byTousers")
  courier_history_courier_history_action_byTousers                   courier_history[]                              @relation("courier_history_action_byTousers")
  cross_payment_details_history                                      cross_payment_details_history[]
  cross_payments_history                                             cross_payments_history[]
  currencies_history_currencies_history_action_byTousers             currencies_history[]                           @relation("currencies_history_action_byTousers")
  debit_note_details_history                                         debit_note_details_history[]
  debit_note_history                                                 debit_note_history[]
  destinations_history_destinations_history_action_byTousers         destinations_history[]                         @relation("destinations_history_action_byTousers")
  document_submission_factory_invoices_history                       document_submission_factory_invoices_history[]
  document_submissions_details_history                               document_submissions_details_history[]
  document_submissions_history                                       document_submissions_history[]
  early_settlement_details_history                                   early_settlement_details_history[]
  early_settlement_percentage_history                                early_settlement_percentage_history[]
  ev_permission_history                                              ev_permission_history[]
  ev_permissions                                                     ev_permissions[]
  exfactory_history                                                  exfactory_history[]
  exfactory_orders_history                                           exfactory_orders_history[]
  exfactory_shipments_history                                        exfactory_shipments_history[]
  fabric_suppliers_history_fabric_suppliers_history_action_byTousers fabric_suppliers_history[]                     @relation("fabric_suppliers_history_action_byTousers")
  fabrics_history_fabrics_history_action_byTousers                   fabrics_history[]                              @relation("fabrics_history_action_byTousers")
  factory_bank_history_factory_bank_history_action_byTousers         factory_bank_history[]                         @relation("factory_bank_history_action_byTousers")
  factory_history_factory_history_action_byTousers                   factory_history[]                              @relation("factory_history_action_byTousers")
  factory_invoice_consignee_history                                  factory_invoice_consignee_history[]
  factory_invoice_details_history                                    factory_invoice_details_history[]
  factory_invoice_history                                            factory_invoice_history[]
  factory_invoice_notify_party_history                               factory_invoice_notify_party_history[]
  factory_orders_history                                             factory_orders_history[]
  factory_payments_header_history                                    factory_payments_header_history[]
  factory_payments_history                                           factory_payments_history[]
  factory_shipment_details_history                                   factory_shipment_details_history[]
  fob_type_history                                                   fob_type_history[]
  fob_types                                                          fob_types[]
  freight_term                                                       freight_term[]
  freight_term_history                                               freight_term_history[]
  handover_dates_history                                             handover_dates_history[]
  lc_amendment_history                                               lc_amendment_history[]
  lc_amendment_orders_history                                        lc_amendment_orders_history[]
  lc_amendment_shipments_history                                     lc_amendment_shipments_history[]
  lc_master_history                                                  lc_master_history[]
  lc_orders_history                                                  lc_orders_history[]
  lc_shipments_history                                               lc_shipments_history[]
  lc_transfer_details_history                                        lc_transfer_details_history[]
  lc_transfer_history                                                lc_transfer_history[]
  level_permission                                                   level_permission[]
  level_permission_history_level_permission_history_action_byTousers level_permission_history[]                     @relation("level_permission_history_action_byTousers")
  level_permission_history_level_permission_history_added_byTousers  level_permission_history[]                     @relation("level_permission_history_added_byTousers")
  levels_history                                                     levels_history[]
  order_styles_history                                               order_styles_history[]
  overseas_office_history_overseas_office_history_action_byTousers   overseas_office_history[]                      @relation("overseas_office_history_action_byTousers")
  payment_terms_history_payment_terms_history_action_byTousers       payment_terms_history[]                        @relation("payment_terms_history_action_byTousers")
  permissions_permissions_added_byTousers                            permissions[]                                  @relation("permissions_added_byTousers")
  permissions_permissions_user_idTousers                             permissions[]                                  @relation("permissions_user_idTousers")
  permissions_history_permissions_history_action_byTousers           permissions_history[]                          @relation("permissions_history_action_byTousers")
  permissions_history_permissions_history_added_byTousers            permissions_history[]                          @relation("permissions_history_added_byTousers")
  permissions_history_permissions_history_user_idTousers             permissions_history[]                          @relation("permissions_history_user_idTousers")
  proceed_realization_details_history                                proceed_realization_details_history[]
  proceed_realization_history                                        proceed_realization_history[]
  product_types_history_product_types_history_action_byTousers       product_types_history[]                        @relation("product_types_history_action_byTousers")
  products_history_products_history_action_byTousers                 products_history[]                             @relation("products_history_action_byTousers")
  rdl_invoice_details_history                                        rdl_invoice_details_history[]
  rdl_invoice_history                                                rdl_invoice_history[]
  rdl_invoice_shipment_details_history                               rdl_invoice_shipment_details_history[]
  sales_contract_amendment_details_history                           sales_contract_amendment_details_history[]
  sales_contract_amendment_history                                   sales_contract_amendment_history[]
  sales_contract_consignees_history                                  sales_contract_consignees_history[]
  sales_contract_contact_person_history                              sales_contract_contact_person_history[]
  sales_contract_details_history                                     sales_contract_details_history[]
  sales_contracts_history                                            sales_contracts_history[]
  seasons_history                                                    seasons_history[]
  shipment_details_history                                           shipment_details_history[]
  shipment_item_details_history                                      shipment_item_details_history[]
  shipment_tolerance_level_history                                   shipment_tolerance_level_history[]
  team_members                                                       team_members[]
  team_members_history                                               team_members_history[]
  teams_history                                                      teams_history[]
  tna_actions_history_tna_actions_history_action_byTousers           tna_actions_history[]                          @relation("tna_actions_history_action_byTousers")
  tna_base_actions_history                                           tna_base_actions_history[]
  tna_plan_details_history                                           tna_plan_details_history[]
  tna_plan_history                                                   tna_plan_history[]
  tna_template_actions_history                                       tna_template_actions_history[]
  tna_templates_history                                              tna_templates_history[]
  user_sessions                                                      user_sessions[]
  departments                                                        departments                                    @relation(fields: [department_id], references: [id], onUpdate: NoAction)
  levels                                                             levels                                         @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_history_users_history_action_byTousers                       users_history[]                                @relation("users_history_action_byTousers")
}

model users_history {
  id                                   Int       @id @default(autoincrement())
  users_id                             String?   @db.Uuid
  first_name                           String?   @db.VarChar(25)
  last_name                            String?   @db.VarChar(25)
  phone_no                             String?   @db.VarChar(18)
  password                             String?
  email                                String?   @db.VarChar(50)
  department_id                        Int?
  level_id                             Int?
  user_id                              String?   @db.VarChar(20)
  is_active                            Boolean?
  hashed_password                      String?
  action_by                            String?   @db.Uuid
  action_type                          actions?
  action_at                            DateTime? @default(now()) @db.Timestamp(6)
  users_users_history_action_byTousers users?    @relation("users_history_action_byTousers", fields: [action_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model user_sessions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  session_token String
  ip            String?   @db.Inet
  browser       String?
  login_time    DateTime? @default(now()) @db.Timestamptz(6)
  expire_date   DateTime? @default(dbgenerated("(CURRENT_TIMESTAMP + '18:00:00'::interval)")) @db.Timestamptz(6)
  logout_at     DateTime? @db.Timestamptz(6)
  device_id     String?
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model authorizations {
  id             Int          @id @default(autoincrement())
  module_id      Int?
  level_id       Int?
  is_enabled     Boolean      @default(true)
  name           String       @db.VarChar(50)
  updated_by     String?      @db.Uuid
  updated_at     DateTime?    @default(now()) @db.Timestamp(6)
  department_id  Int?
  approval_level Int?
  levels         levels?      @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modules        modules?     @relation(fields: [module_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?       @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments    departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "department_id_foreign_key")
}

model companies {
  id              Int               @id @default(autoincrement())
  name            String            @unique(map: "unique_company_name") @db.VarChar(30)
  country_id      Int?
  currencies_id   Int?
  email           String?           @db.VarChar(30)
  phone_no        String?           @db.VarChar(18)
  city            String?           @db.VarChar(15)
  street          String?
  zip_code        String?           @db.VarChar(6)
  old_pk          Int?
  added_at        DateTime?         @default(now()) @db.Timestamp(6)
  countries       countries?        @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currencies      currencies?       @relation(fields: [currencies_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company_banks   company_banks[]
  lc_master       lc_master[]
  sales_contracts sales_contracts[]
}

model countries {
  id               Int                @id @default(autoincrement())
  name             String             @unique(map: "unique_countries") @db.VarChar(20)
  country_code     String?            @db.VarChar(5)
  old_pk           Int?
  added_at         DateTime?          @default(now()) @db.Timestamp(6)
  banks            banks[]
  buyers           buyers[]
  companies        companies[]
  destinations     destinations[]
  fabric_suppliers fabric_suppliers[]
  overseas_offices overseas_offices[]
}

model currencies {
  id               Int                @id @default(autoincrement())
  name             String             @unique(map: "unique_currencies") @db.VarChar(10)
  symbol           String             @db.VarChar(2)
  currency_code    String?            @db.VarChar(5)
  old_pk           Int?
  added_at         DateTime?          @default(now()) @db.Timestamp(6)
  buyer_orders     buyer_orders[]
  companies        companies[]
  factory_orders   factory_orders[]
  lc_master        lc_master[]
  overseas_offices overseas_offices[]
}

model destinations {
  id                 Int                  @id @default(autoincrement())
  country_id         Int?
  old_pk             Int?
  name               String               @unique(map: "unique_destinations") @db.VarChar(50)
  added_at           DateTime?            @default(now()) @db.Timestamp(6)
  buyer_destinations buyer_destinations[]
  countries          countries?           @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  factory_invoice    factory_invoice[]
  sales_contracts    sales_contracts[]
  shipment_details   shipment_details[]
}

model overseas_offices {
  id            Int         @id @default(autoincrement())
  name          String      @unique(map: "unique_overseas_office") @db.VarChar(25)
  email_address String?     @db.VarChar(40)
  phone_no      String?     @db.VarChar(18)
  currency_id   Int?
  country_id    Int?
  city          String?     @db.VarChar(15)
  street        String?
  zip           String?     @db.VarChar(8)
  old_pk        Int?
  added_at      DateTime?   @default(now()) @db.Timestamp(6)
  buyers        buyers[]
  countries     countries?  @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currencies    currencies? @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model payment_terms {
  id                 Int                  @id @default(autoincrement())
  term_id            Int
  tenor              Int
  term_description   String
  old_pk             Int?
  added_at           DateTime?            @default(now()) @db.Timestamp(6)
  buyer_payment_term buyer_payment_term[]
  terms              terms                @relation(fields: [term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipment_details   shipment_details[]

  @@unique([term_id, tenor, term_description], map: "unique_payment_terms")
}

model terms {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(5)
  commission_invoice   commission_invoice[]
  cross_payments       cross_payments[]
  debit_note           debit_note[]
  document_submissions document_submissions[]
  exfactory            exfactory[]
  factory_invoice      factory_invoice[]
  payment_terms        payment_terms[]
  proceed_realization  proceed_realization[]
  rdl_invoice          rdl_invoice[]
}

model banks {
  id            Int             @id @default(autoincrement())
  name          String          @unique(map: "unique_banks") @db.VarChar(100)
  country_id    Int?
  old_pk        Int?
  added_at      DateTime?       @default(now()) @db.Timestamp(6)
  countries     countries?      @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  buyer_banks   buyer_banks[]
  company_banks company_banks[]
  factory_bank  factory_bank[]
}

model fabrics {
  id                  Int            @id @default(autoincrement())
  product_type_id     Int?
  old_product_type_id Int?
  description         String?        @db.VarChar(255)
  composition         String?
  name                String?
  value               Int?
  unit                String?        @db.VarChar(10)
  old_pk              Int?
  added_at            DateTime?      @default(now()) @db.Timestamp(6)
  product_types       product_types? @relation(fields: [product_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order_styles        order_styles[]

  @@unique([name, product_type_id], map: "unique_fabric")
}

model product_types {
  id           Int            @id @default(autoincrement())
  name         String         @unique(map: "unique_product_type") @db.VarChar(25)
  is_active    Boolean?       @default(true)
  old_pk       Int?
  added_at     DateTime?      @default(now()) @db.Timestamp(6)
  fabrics      fabrics[]
  order_styles order_styles[]
  products     products[]
}

model products {
  id                  Int            @id @default(autoincrement())
  name                String         @db.VarChar(255)
  product_type_id     Int?
  old_product_type_id Int?
  is_active           Boolean?       @default(true)
  old_pk              Int?
  added_at            DateTime?      @default(now()) @db.Timestamp(6)
  order_styles        order_styles[]
  product_types       product_types? @relation(fields: [product_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([name, product_type_id], map: "unique_products")
}

model banks_history {
  id                                   Int       @id @default(autoincrement())
  bank_id                              Int?
  name                                 String?   @db.VarChar(100)
  country_id                           Int?
  action_type                          actions?
  action_by                            String?   @db.Uuid
  action_at                            DateTime? @default(now()) @db.Timestamp(6)
  users_banks_history_action_byTousers users?    @relation("banks_history_action_byTousers", fields: [action_by], references: [id], onUpdate: NoAction)
}

model companies_history {
  id                                       Int       @id @default(autoincrement())
  company_id                               Int?
  name                                     String?   @db.VarChar(30)
  country_id                               Int?
  currencies_id                            Int?
  email                                    String?   @db.VarChar(30)
  phone_no                                 String?   @db.VarChar(18)
