# Use the existing Nexus database, with its tables and data already provisioned.
# The database host must be reachable from both containers; localhost refers
# to the container itself, not the VPS.
DATABASE_URL=postgresql://nexus_user:REPLACE_PASSWORD@YOUR_DATABASE_HOST:5432/nexus?schema=public

# Preserve the current Nexus JWT secret to keep existing sessions valid.
# For a new installation, choose a random secret of at least 32 characters.
JWT_SECRET=REPLACE_WITH_YOUR_EXISTING_JWT_SECRET
